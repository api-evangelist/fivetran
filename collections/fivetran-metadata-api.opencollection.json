{
  "opencollection": "1.0.0",
  "info": {
    "name": "Fivetran REST Connections Metadata API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Metadata",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List supported connector types",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.fivetran.com/v1/metadata/connector-types"
          },
          "docs": "List supported connector types"
        }
      ]
    }
  ],
  "bundled": true
}