{
  "opencollection": "1.0.0",
  "info": {
    "name": "Fivetran REST Connections Teams API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Teams",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List teams",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.fivetran.com/v1/teams"
          },
          "docs": "List teams"
        },
        {
          "info": {
            "name": "Create a team",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.fivetran.com/v1/teams",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a team"
        }
      ]
    }
  ],
  "bundled": true
}